# --- Admin Dashboard ---
AGENT_CATALOG_PATH=agents/catalog.json

# CORS configuration. Comma-separated list of fully-qualified origins.
# A literal "*" is honoured for local dev only — it is refused at startup
# when running on Cloud Run (K_SERVICE is set) or when
# CORS_REFUSE_WILDCARD=true, locking cross-origin off entirely. P1 #7.
CORS_ALLOWED_ORIGINS=http://localhost:9118,http://127.0.0.1:9118,http://localhost:9119,http://127.0.0.1:9119,http://localhost:4200,http://127.0.0.1:4200,http://localhost:9100,http://localhost:9101,http://localhost:9102,http://localhost:9112,http://127.0.0.1:9100,http://127.0.0.1:9112

# ── Structured logging (G5a) ────────────────────────────────────────
# Selects the log/slog handler emitted by every Go service. All log
# lines that go through `logging.FromContext(ctx)` automatically
# carry request_id + tenant attributes (org_id, user_id, role,
# plan_tier) when present.
#
#   LOG_FORMAT  text  Default. Human-readable key=value, ideal for
#                     local `make start`.
#               json  Plain slog.JSONHandler. Use with any JSON log
#                     aggregator (Loki, Datadog, etc.).
#               gcp   JSON with field renames for Cloud Logging
#                     (severity / message / timestamp). Use on Cloud
#                     Run / GKE so logs are categorized by severity.
#   LOG_LEVEL   debug | info (default) | warn | error
LOG_FORMAT=
LOG_LEVEL=

# ── Distributed tracing (G5b) ───────────────────────────────────────
# OpenTelemetry tracing for cross-service request correlation. Each
# Gin router emits one span per request with method/path/status +
# tenant attrs (org.id, user.id). W3C tracecontext is honored on
# inbound requests so a single trace spans gateway → admin →
# billing transparently.
#
#   OTEL_EXPORTER          ""      Default: no-op TracerProvider
#                                  (zero overhead, byte-identical
#                                  to legacy).
#                          stdout  Pretty-print spans to stderr.
#                                  Local debugging only — verbose.
#                          gcp     Cloud Trace via the operations-go
#                                  exporter. Requires
#                                  GOOGLE_CLOUD_PROJECT + ADC.
#   OTEL_SAMPLE_RATIO      0.1     Head-sampling probability in
#                                  [0,1]. 0.1 keeps Cloud Trace
#                                  under the 2.5M-spans/month free
#                                  tier on busy days. Set to 1.0
#                                  during incident debugging.
#   OTEL_SERVICE_NAME      auto    Override the service name shown
#                                  in Cloud Trace (default = the
#                                  binary's race-<name> label).
#   OTEL_SERVICE_VERSION   unknown e.g. v1.2.3 — useful for spotting
#                                  regressions tied to a deploy.
#   OTEL_ENVIRONMENT       ""      e.g. prod / staging / local.
OTEL_EXPORTER=
OTEL_SAMPLE_RATIO=
OTEL_SERVICE_VERSION=
OTEL_ENVIRONMENT=

# ── Security headers (G4a) ──────────────────────────────────────────
# Hardening middleware emits X-Frame-Options, X-Content-Type-Options,
# Referrer-Policy, Permissions-Policy on every response, and a CSP.
# All four knobs default to empty (= safe/no-op behavior); flip them
# only when you have validated nothing breaks.
#
#   CSP_ENFORCE    Empty (default) sends `Content-Security-Policy-Report-Only`
#                  so violations are reported but never block. Set to
#                  `true` to switch to enforcement mode.
#                  RECOMMENDED ROLLOUT: deploy with this empty for ~1 week,
#                  watch Cloud Logging for CSP violation reports, then flip
#                  to true.
#   CSP_OVERRIDE   Empty (default) uses the built-in policy which whitelists
#                  Firebase Auth + Identity Platform + websockets + the Auth
#                  Emulator. Set to a complete CSP string to replace it.
#   CSP_DISABLE    Empty (default) emits a CSP. Set to `true` to skip CSP
#                  entirely (escape hatch only — leaves the app exposed).
#   SECURITY_HSTS  Empty (default) does NOT send Strict-Transport-Security.
#                  Set to `true` to send `max-age=31536000; includeSubDomains`
#                  on HTTPS responses. Only flip this after the prod domain
#                  is stable on HTTPS — HSTS is sticky in browsers.
CSP_ENFORCE=
CSP_OVERRIDE=
CSP_DISABLE=
SECURITY_HSTS=

# ── Organizational Intelligence: Google Maps MCP (Optional) ─────────
# Enables the Organizational Intelligence Layer in the leadership planner:
#   • Stakeholder Venue Discovery — anchors all 10 personas to real Las Vegas
#     institutions (Convention Center, Courthouse, Union Hall, Data Center, etc.)
#   • Environmental Pressure Layer — weather conditions affect crisis
#     severity and outdoor engagement feasibility
# The route visualization is unaffected — it always uses the road network.
# Requires 5 APIs enabled: apikeys, agentregistry, mapstools, places, weather.
# See README.md "Google Maps API key" section for setup.
# Fetch from Secret Manager: gcloud secrets versions access latest --secret=maps-api-key --project=your-gcp-project-id
GOOGLE_MAPS_API_KEY=

# --- Agent Model Overrides ---
EVALUATOR_MODEL=gemini-3-flash-preview
# SIMULATOR_MODEL=gemini-3.5-flash-lite  # Default simulator model (Vertex AI).
# RUNNER_MODEL=gemini-3.5-flash-lite  # Default (Vertex AI). For local Ollama: ollama_chat/gemma4:e2b

# --- Agent Model Selection ---
# PLANNER_MODEL=gemini-3-flash-preview         # Gemini model for planner agents
# AGENT_NAME=runner  # Default agent identity. Set to "runner_gke" for GKE deployment.

# --- Gemini Retry Configuration ---
# Automatic retry with exponential backoff for transient Gemini API errors
# (429 rate limits, 500/502/503/504 server errors).
# GEMINI_RETRY_ATTEMPTS=5        # Total attempts including initial call
# GEMINI_RETRY_INITIAL_DELAY=1.0 # Seconds before first retry
# GEMINI_RETRY_MAX_DELAY=60.0    # Maximum delay cap between retries

# --- vLLM on GKE (Gemma 4) ---
# Use with kubectl port-forward svc/vllm-service 8080:9100
# See docs/guides/gke-vllm-setup.md for full setup instructions.
# RUNNER_MODEL=openai/gemma-4-E4B-it
# VLLM_API_URL=http://localhost:8080/v1

# --- GKE Runner (runner_gke) ---
# LLM-powered runner deployed on GKE with Internal LoadBalancer.
# Set after deploying: kubectl get svc runner-gke -n runner -o jsonpath='{.status.loadBalancer.ingress[0].ip}'
# See docs/guides/gke-runner-setup.md for setup instructions.
# RUNNER_GKE_INTERNAL_URL=http://<internal-lb-ip>:9108


# --- Multi-tenant SaaS shell (Phase 0 -- scaffolding only) ---
# These variables are defined now so future phases have a stable
# contract. In Phase 0 nothing reads them at runtime.
#
# IDENTITY_PROVIDER: which Resolver to install at the HTTP edge.
#   local    -- fixture org local-dev / user local-user (default for `make start`)
#   firebase -- verify Firebase ID tokens (cloud)
#   iap      -- map IAP-injected headers to a tenant (cloud, optional)
IDENTITY_PROVIDER=local

# --- Account / Auth ---
# ACCOUNT_KEY_PREFIX=acct                      # Prefix for account keys in Redis
# IAP_CLIENT_ID=                               # Google IAP client ID (production only)
# LOCAL_RESOLVER_ALLOW_NON_LOOPBACK=false      # Allow non-loopback IPs in local auth resolver
# LOCAL_DEV_USER_EMAIL=dev@example.com         # Identity injected by LocalResolver (only when IDENTITY_PROVIDER=local)
# USERS_MIGRATIONS_DIR=                        # Path to account migration SQL files (auto-discovered when empty)
# GATEWAY_AUDIENCE=                            # OIDC audience for IAM-protected gateway (Cloud Run only)
# AGENT_AUDIENCE=                              # OIDC audience for IAM-protected agent calls (Cloud Run only)
#
# BILLING_PROVIDER: where org plan tier comes from.
#   stub   -- read from configs/local_plans.yaml (default for `make start`)
#   stripe -- read from `organizations.plan_tier`, updated by Stripe webhook
BILLING_PROVIDER=stub
#
# STRIPE_WEBHOOK_SECRET: HMAC signing secret for cmd/billing's /webhook
# endpoint. REQUIRED when BILLING_PROVIDER=stripe (the service refuses
# to start without it). Find it in the Stripe Dashboard under
# Developers > Webhooks > <endpoint> > Signing secret.
# STRIPE_WEBHOOK_SECRET=whsec_xxx
#
# STRIPE_PRICE_MAP: comma-separated price_id:plan_tier pairs. The
# webhook handler uses this to translate the Stripe price on a
# checkout.session.completed event into a tenant plan tier. Unmapped
# price IDs are rejected with 422 — never silently promoted.
#
# Used BOTH by cmd/billing (forward direction: price_id → tier on
# incoming webhooks) AND by cmd/gateway's StripeCheckoutCreator
# (reverse direction: tier → price_id when starting a Checkout
# session). Both directions must agree, so configure ONCE here.
# Example: STRIPE_PRICE_MAP=price_1ABCpro:pro,price_1XYZteam:team
# STRIPE_PRICE_MAP=
#
# STRIPE_API_KEY: server-side secret key (sk_test_... in dev,
# sk_live_... in prod). REQUIRED to arm the real
# StripeCheckoutCreator + StripePortalCreator in cmd/gateway.
# Without it the gateway falls back to the stub creator and the
# upgrade modal shows "self-serve upgrades not yet enabled".
# Get it from: Stripe Dashboard > Developers > API keys.
# STRIPE_API_KEY=sk_test_xxx
#
# STRIPE_RETURN_BASE_URL: the public base URL the user is
# bounced back to after Stripe-hosted Checkout / Portal flows.
# The gateway appends `/#/settings/billing?checkout=success` (or
# `=cancel`) for Checkout, and uses the bare URL as the return
# target for Portal. REQUIRED with STRIPE_API_KEY — empty value
# forces the fallback to stub.
# Local dev: http://localhost:9118
# Cloud:     https://<your-frontend-domain>
# STRIPE_RETURN_BASE_URL=
#
# TENANT_KEY_PREFIX: namespace prefix for tenant-scoped Redis keys
# constructed via the internal/tenant key helper (added in Phase 2).
# Leave as `t` unless you are running parallel deployments against the
# same Redis instance.
TENANT_KEY_PREFIX=t
#
# METERING_SINK: where the after_model_callback writes token-usage
# events (added in Phase 4).
#   stdout -- log only; for `make start` debugging
#   sqlite -- append to data/metering.db (local SaaS mode)
#   pubsub -- publish to topic `usage-metering` (cloud)
METERING_SINK=stdout

# --- Metering ---
# METERING_PUBSUB_SUBSCRIPTION=usage-metering-sub  # Pub/Sub subscription for metering events
#
# SAAS_MODE: master switch for the SaaS shell.
#   off (default) -- legacy single-tenant behavior, byte-identical to today
#   on            -- apply migrations/0001_tenancy.sql, mount tenant middleware,
#                    start the metering consumer, enforce quotas
SAAS_MODE=off
#
# BOOTSTRAP_SUPERADMIN_EMAIL: email of the first user added to the
# built-in `system` org with role `superadmin` on first boot. Only
# consulted when SAAS_MODE=on and the `system` org has no members.
# Leave blank in local dev; the local Resolver does not require it.
BOOTSTRAP_SUPERADMIN_EMAIL=
#
# Firebase Auth (only consulted when IDENTITY_PROVIDER=firebase).
# For local dev, run `make saas-local` — it starts the emulator and
# sets FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 for you.
# In the cloud, fill in the project's web API key + project ID.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
# When set, the gateway, admin, and frontend BFF skip RSA/JWKS
# verification and treat tokens issued by the emulator as valid
# (they are unsigned, which is by design in the emulator).
FIREBASE_AUTH_EMULATOR_HOST=

# reCAPTCHA Enterprise site key for Firebase App Check. When set, the
# /login page initializes App Check with the ReCaptchaEnterpriseProvider
# so signup/sign-in traffic is attested by reCAPTCHA before Firebase
# Auth processes the credential. Empty = App Check disabled.
#
# Operator steps to enable (one-time):
#   1. In Firebase console -> App Check, register the web app and
#      pick reCAPTCHA Enterprise as the provider.
#   2. Copy the SITE KEY into this var (NOT the API key).
#   3. Enable enforcement for the Authentication API after a few hours
#      of soft-launch traffic to confirm tokens are flowing.
#
# Note: leave empty for local dev against the Firebase emulator
# (App Check has no emulator path; login/index.html skips it when
# FIREBASE_AUTH_EMULATOR_HOST is set).
RECAPTCHA_ENTERPRISE_SITE_KEY=

# ── Per-user data isolation ──────────────────────────────────────
# Set to "on" to enable per-user tenant isolation for leadership
# scenarios and simulation summaries.  When off (default), all users
# share a single data namespace (single-tenant legacy mode).
# LEADERSHIP_PER_USER_ISOLATION=on
