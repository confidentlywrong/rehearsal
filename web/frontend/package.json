    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.10",
    "@angular/router": "^21.2.25",
    "firebase": "^10.7.1",
    "ngx-countup": "^21.0.0",
    "ngx-markdown": "^21.1.0",
    "protobufjs": "^8.8.1",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1",
    "tslib": "^2.3.0",
    "tweakpane": "^4.0.5",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
